{
  "name": "cinebridge-recomendacao",
  "version": "1.0.0",
  "description": "CineBridge: microsserviço de recomendação e orquestração de equipes audiovisuais (Strategy, Template Method, Observer e Visitor)",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx scripts/demo.ts",
    "carga": "tsx scripts/carga.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": ["cinebridge", "design-patterns", "fastify", "prisma", "typescript"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autocannon": "^8.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "fastify": "^5.12.3",
    "pino": "^10.3.1"
  }
}
