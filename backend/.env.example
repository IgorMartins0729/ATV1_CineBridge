# Copie para .env e ajuste. O .env não vai para o git.

# --- Banco de dados (PostgreSQL via Prisma) ---
# Docker (docker-compose.yml): usuário/senha cinebridge. PostgreSQL instalado: normalmente usuário postgres.
DATABASE_URL="postgresql://cinebridge:cinebridge@localhost:5432/cinebridge_db?schema=public"

# "memoria" (padrão, não precisa de banco) ou "prisma" (usa o DATABASE_URL)
REPOSITORIO=memoria
# Quantos profissionais fictícios gerar no modo memória
PROFISSIONAIS_MEMORIA=10000

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Processos em paralelo (use mais de 1 junto com REPOSITORIO=prisma)
WORKERS=1

# --- Parâmetros do algoritmo (opcionais) ---
# ESTRATEGIA_PADRAO=similaridade-cosseno
# LIMITE_ORCAMENTO_REDUZIDO=50000
# QUANTIDADE_SUGESTOES=3
# TIMEOUT_REPOSITORIO_MS=1000
# PARAMETROS_JSON={"estrategias":{"cosseno":{"pesoMagnitude":0.3}}}
